# VASPTrace — environment template
# Copy to .env and fill in. NEVER commit .env.
# Every key here is read server-side only and is never exposed to the browser.

# ─── app ────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000  # comma-separated

# Demo bearer token the frontend sends as X-Api-Key (MVP auth, Phase 1).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_API_KEY=

# ─── database (Phase 2) ─────────────────────────────────────────────────────
# Supabase pooled connection string, e.g.
# postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave empty to fall back to local SQLite for development only.
DATABASE_URL=
DB_ECHO=false

# ─── blockchain data providers (Phase 3/4) ──────────────────────────────────
# Without keys the adapters run in fixture/mock mode and every response is
# labelled data_provenance=mock_demo. Mock data is never presented as real.
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
TRONGRID_API_KEY=
TRONGRID_BASE_URL=https://api.trongrid.io
TRONSCAN_BASE_URL=https://apilist.tronscanapi.com/api
BITQUERY_API_KEY=
BITQUERY_BASE_URL=https://streaming.bitquery.io/graphql

# ─── traversal budgets (Phase 6) ────────────────────────────────────────────
DEFAULT_HOP_DEPTH=3
MAX_HOP_DEPTH=6
MAX_NODES_EXPANDED=400
MAX_API_CALLS_PER_TRACE=120
MAX_TXS_PER_ADDRESS=200
WALL_CLOCK_BUDGET_S=10
FANOUT_TERMINAL=500

# ─── attribution / labels (Phase 7/8) ───────────────────────────────────────
MIN_ATTRIBUTION_SCORE=35
STALE_LABEL_DAYS=30
# Allow source_tier=demo_unverified labels to load. They can never produce a
# primary attribution on their own.
ALLOW_DEMO_LABELS=false

# ─── caching & rate limiting ────────────────────────────────────────────────
CHAIN_CACHE_TTL_S=900
RATE_LIMIT_TRACES_PER_MINUTE=10
RATE_LIMIT_TRACES_PER_HOUR=100

# ─── frontend ───────────────────────────────────────────────────────────────
# The browser never calls the backend directly. Next.js proxies every request
# through /api/backend/* (a server-side route handler) and injects DEMO_API_KEY
# there, so no key is ever present in a bundle or a network tab.
# Set these in frontend/.env.local — see frontend/.env.example.
#   BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/v1
#   DEMO_API_KEY=<same value as above>
