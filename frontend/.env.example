# VASPTrace frontend — copy to .env.local and fill in. NEVER commit .env.local.
#
# Both values are SERVER-SIDE ONLY: they are read inside the route handler at
# src/app/api/backend/[...path]/route.ts and are never sent to the browser.
# Nothing here is prefixed NEXT_PUBLIC_, which is what keeps them out of the bundle.

# Where the FastAPI backend is reachable from the Next.js server.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Must match DEMO_API_KEY in the backend's .env. Leave empty while the backend
# has no key configured (development only).
DEMO_API_KEY=
